[
 {
  "start": 0.0,
  "end": 1.1,
  "text": "Một trang chữ phải đi qua"
 },
 {
  "start": 1.1,
  "end": 1.8,
  "text": "bao nhiêu thế kỷ"
 },
 {
  "start": 1.8,
  "end": 2.69,
  "text": "mới đến được tay bạn?"
 },
 {
  "start": 2.69,
  "end": 5.36,
  "text": "Theo sử cũ, năm 105,"
 },
 {
  "start": 5.36,
  "end": 6.31,
  "text": "quan Thái Luân dâng vua"
 },
 {
  "start": 6.31,
  "end": 7.72,
  "text": "cách làm giấy từ vỏ cây,"
 },
 {
  "start": 7.72,
  "end": 9.53,
  "text": "sợi gai, giẻ rách và lưới cá."
 },
 {
  "start": 9.53,
  "end": 11.32,
  "text": "Rồi người ta khắc chữ ngược"
 },
 {
  "start": 11.32,
  "end": 13.38,
  "text": "lên ván gỗ, phết mực, ép giấy."
 },
 {
  "start": 13.38,
  "end": 15.43,
  "text": "Kinh Kim Cương in năm 868"
 },
 {
  "start": 15.43,
  "end": 16.68,
  "text": "là cuốn sách in có ghi năm"
 },
 {
  "start": 16.68,
  "end": 18.1,
  "text": "sớm nhất còn lại."
 },
 {
  "start": 18.1,
  "end": 20.19,
  "text": "Ở Việt Nam, hơn 34.000 tấm"
 },
 {
  "start": 20.19,
  "end": 20.89,
  "text": "mộc bản triều Nguyễn"
 },
 {
  "start": 20.89,
  "end": 22.74,
  "text": "được UNESCO công nhận năm 2009,"
 },
 {
  "start": 22.74,
  "end": 23.89,
  "text": "là di sản tư liệu thế giới"
 },
 {
  "start": 23.89,
  "end": 24.72,
  "text": "đầu tiên của nước ta."
 },
 {
  "start": 24.72,
  "end": 28.25,
  "text": "Khoảng năm 1450, ở Mainz,"
 },
 {
  "start": 28.25,
  "end": 29.25,
  "text": "Gutenberg đúc từng con chữ"
 },
 {
  "start": 29.25,
  "end": 30.5,
  "text": "kim loại rời, xếp thành trang"
 },
 {
  "start": 30.5,
  "end": 31.26,
  "text": "rồi ép bằng máy."
 },
 {
  "start": 31.26,
  "end": 33.53,
  "text": "Sách bắt đầu được in hàng loạt."
 },
 {
  "start": 33.53,
  "end": 34.94,
  "text": "Còn hôm nay, mỗi chữ bạn đang đọc"
 },
 {
  "start": 34.94,
  "end": 35.74,
  "text": "chỉ là những điểm sáng"
 },
 {
  "start": 35.74,
  "end": 36.83,
  "text": "trên màn hình."
 },
 {
  "start": 36.83,
  "end": 38.53,
  "text": "Từ vỏ cây đến điểm sáng,"
 },
 {
  "start": 38.53,
  "end": 40.23,
  "text": "chữ chưa bao giờ ngừng lên đường."
 },
 {
  "start": 40.23,
  "end": 41.93,
  "text": "Theo dõi QBK để xem tiếp nhé."
 }
]