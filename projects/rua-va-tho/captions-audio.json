[
 {
  "start": 0.25,
  "end": 1.33,
  "text": "Một con vật chậm rì"
 },
 {
  "start": 1.33,
  "end": 2.54,
  "text": "lại thắng một con vật"
 },
 {
  "start": 2.54,
  "end": 3.14,
  "text": "nhanh như gió."
 },
 {
  "start": 3.14,
  "end": 4.4,
  "text": "Bằng cách nào?"
 },
 {
  "start": 4.4,
  "end": 5.69,
  "text": "Đây là truyện ngụ ngôn"
 },
 {
  "start": 5.69,
  "end": 6.34,
  "text": "Rùa và Thỏ,"
 },
 {
  "start": 6.34,
  "end": 7.82,
  "text": "tương truyền của Ê-dốp."
 },
 {
  "start": 7.82,
  "end": 8.86,
  "text": "Thỏ chạy nhanh nhất vùng,"
 },
 {
  "start": 8.86,
  "end": 10.1,
  "text": "lại rất hay khoe."
 },
 {
  "start": 10.1,
  "end": 11.03,
  "text": "Thỏ cười Rùa:"
 },
 {
  "start": 11.03,
  "end": 11.97,
  "text": "\"Chậm thế thì bao giờ"
 },
 {
  "start": 11.97,
  "end": 12.94,
  "text": "mới tới nơi?\""
 },
 {
  "start": 12.94,
  "end": 13.66,
  "text": "Rùa bình tĩnh đáp:"
 },
 {
  "start": 13.66,
  "end": 15.42,
  "text": "\"Vậy ta thi chạy nhé!\""
 },
 {
  "start": 15.42,
  "end": 16.63,
  "text": "Cả khu rừng kéo đến xem."
 },
 {
  "start": 16.63,
  "end": 18.56,
  "text": "Ba, hai, một, chạy!"
 },
 {
  "start": 18.56,
  "end": 20.8,
  "text": "Thỏ vọt đi như tên bắn,"
 },
 {
  "start": 20.8,
  "end": 21.76,
  "text": "bụi bay mù mịt."
 },
 {
  "start": 21.76,
  "end": 23.35,
  "text": "Rùa thì từng bước,"
 },
 {
  "start": 23.35,
  "end": 24.19,
  "text": "từng bước, chậm rì."
 },
 {
  "start": 24.19,
  "end": 25.74,
  "text": "Chạy được nửa đường,"
 },
 {
  "start": 25.74,
  "end": 26.72,
  "text": "Thỏ ngoái lại."
 },
 {
  "start": 26.72,
  "end": 28.3,
  "text": "Rùa vẫn còn tít đằng xa."
 },
 {
  "start": 28.3,
  "end": 30.0,
  "text": "Thỏ nghĩ: \"Dư sức thắng!"
 },
 {
  "start": 30.0,
  "end": 31.48,
  "text": "Chợp mắt một chút đã.\""
 },
 {
  "start": 31.48,
  "end": 32.82,
  "text": "Thế là Thỏ nằm dưới gốc cây,"
 },
 {
  "start": 32.82,
  "end": 33.65,
  "text": "ngủ khò khò."
 },
 {
  "start": 33.65,
  "end": 34.38,
  "text": "Còn Rùa không dừng lại."
 },
 {
  "start": 34.38,
  "end": 36.26,
  "text": "Không chơi, không ngủ,"
 },
 {
  "start": 36.26,
  "end": 36.81,
  "text": "cứ thế bò."
 },
 {
  "start": 36.81,
  "end": 38.49,
  "text": "Rùa bò qua đồi, qua cỏ,"
 },
 {
  "start": 38.49,
  "end": 40.35,
  "text": "bò qua cả chú Thỏ đang ngáy."
 },
 {
  "start": 40.35,
  "end": 41.96,
  "text": "Mặt trời xuống thấp,"
 },
 {
  "start": 41.96,
  "end": 42.76,
  "text": "Thỏ giật mình tỉnh dậy."
 },
 {
  "start": 42.76,
  "end": 44.41,
  "text": "Thỏ cắm đầu chạy thục mạng."
 },
 {
  "start": 44.41,
  "end": 45.73,
  "text": "Nhưng quá muộn rồi!"
 },
 {
  "start": 45.73,
  "end": 47.23,
  "text": "Rùa đã chạm vạch đích."
 },
 {
  "start": 47.23,
  "end": 48.2,
  "text": "Cả khu rừng reo hò."
 },
 {
  "start": 48.2,
  "end": 49.74,
  "text": "Thỏ chỉ biết gãi tai,"
 },
 {
  "start": 49.74,
  "end": 50.15,
  "text": "xấu hổ."
 },
 {
  "start": 50.15,
  "end": 51.44,
  "text": "Bài học là:"
 },
 {
  "start": 51.44,
  "end": 52.45,
  "text": "chậm mà chắc,"
 },
 {
  "start": 52.45,
  "end": 54.65,
  "text": "còn hơn nhanh mà chủ quan."
 },
 {
  "start": 54.65,
  "end": 55.74,
  "text": "Giỏi đến đâu mà kiêu ngạo,"
 },
 {
  "start": 55.74,
  "end": 56.47,
  "text": "cũng có thể thua."
 },
 {
  "start": 56.47,
  "end": 58.4,
  "text": "Còn bạn, bạn giống Rùa"
 },
 {
  "start": 58.4,
  "end": 58.94,
  "text": "hay giống Thỏ?"
 },
 {
  "start": 58.94,
  "end": 60.14,
  "text": "Bình luận cho mình biết nhé!"
 }
]