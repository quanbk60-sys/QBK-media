[
 {
  "start": 0.3,
  "end": 1.6,
  "text": "Một con vật chậm rì"
 },
 {
  "start": 1.6,
  "end": 3.08,
  "text": "lại thắng một con vật"
 },
 {
  "start": 3.08,
  "end": 3.77,
  "text": "nhanh như gió."
 },
 {
  "start": 3.77,
  "end": 4.68,
  "text": "Bằng cách nào?"
 },
 {
  "start": 4.68,
  "end": 6.53,
  "text": "Đây là truyện ngụ ngôn"
 },
 {
  "start": 6.53,
  "end": 7.24,
  "text": "Rùa và Thỏ,"
 },
 {
  "start": 7.24,
  "end": 8.74,
  "text": "tương truyền của Ê-dốp."
 },
 {
  "start": 8.74,
  "end": 10.63,
  "text": "Thỏ chạy nhanh nhất vùng,"
 },
 {
  "start": 10.63,
  "end": 12.11,
  "text": "lại rất hay khoe."
 },
 {
  "start": 12.11,
  "end": 12.78,
  "text": "Thỏ cười Rùa:"
 },
 {
  "start": 12.78,
  "end": 14.39,
  "text": "\"Chậm thế thì bao giờ"
 },
 {
  "start": 14.39,
  "end": 15.54,
  "text": "mới tới nơi?\""
 },
 {
  "start": 15.54,
  "end": 16.81,
  "text": "Rùa bình tĩnh đáp:"
 },
 {
  "start": 16.81,
  "end": 18.5,
  "text": "\"Vậy ta thi chạy nhé!\""
 },
 {
  "start": 18.5,
  "end": 21.45,
  "text": "Cả khu rừng kéo đến xem."
 },
 {
  "start": 21.45,
  "end": 22.83,
  "text": "Ba, hai, một, chạy!"
 },
 {
  "start": 22.83,
  "end": 24.96,
  "text": "Thỏ vọt đi như tên bắn,"
 },
 {
  "start": 24.96,
  "end": 26.84,
  "text": "bụi bay mù mịt."
 },
 {
  "start": 26.84,
  "end": 28.01,
  "text": "Rùa thì từng bước,"
 },
 {
  "start": 28.01,
  "end": 29.8,
  "text": "từng bước, chậm rì."
 },
 {
  "start": 29.8,
  "end": 30.89,
  "text": "Chạy được nửa đường,"
 },
 {
  "start": 30.89,
  "end": 32.05,
  "text": "Thỏ ngoái lại."
 },
 {
  "start": 32.05,
  "end": 33.39,
  "text": "Rùa vẫn còn tít đằng xa."
 },
 {
  "start": 33.39,
  "end": 35.57,
  "text": "Thỏ nghĩ: \"Dư sức thắng!"
 },
 {
  "start": 35.57,
  "end": 36.84,
  "text": "Chợp mắt một chút đã.\""
 },
 {
  "start": 36.84,
  "end": 38.88,
  "text": "Thế là Thỏ nằm dưới gốc cây,"
 },
 {
  "start": 38.88,
  "end": 40.16,
  "text": "ngủ khò khò."
 },
 {
  "start": 40.16,
  "end": 41.7,
  "text": "Còn Rùa không dừng lại."
 },
 {
  "start": 41.7,
  "end": 43.49,
  "text": "Không chơi, không ngủ,"
 },
 {
  "start": 43.49,
  "end": 44.44,
  "text": "cứ thế bò."
 },
 {
  "start": 44.44,
  "end": 46.24,
  "text": "Rùa bò qua đồi, qua cỏ,"
 },
 {
  "start": 46.24,
  "end": 48.42,
  "text": "bò qua cả chú Thỏ đang ngáy."
 },
 {
  "start": 48.42,
  "end": 50.34,
  "text": "Mặt trời xuống thấp,"
 },
 {
  "start": 50.34,
  "end": 51.72,
  "text": "Thỏ giật mình tỉnh dậy."
 },
 {
  "start": 51.72,
  "end": 53.29,
  "text": "Thỏ cắm đầu chạy thục mạng."
 },
 {
  "start": 53.29,
  "end": 55.36,
  "text": "Nhưng quá muộn rồi!"
 },
 {
  "start": 55.36,
  "end": 56.29,
  "text": "Rùa đã chạm vạch đích."
 },
 {
  "start": 56.29,
  "end": 57.83,
  "text": "Cả khu rừng reo hò."
 },
 {
  "start": 57.83,
  "end": 59.68,
  "text": "Thỏ chỉ biết gãi tai,"
 },
 {
  "start": 59.68,
  "end": 60.17,
  "text": "xấu hổ."
 },
 {
  "start": 60.17,
  "end": 61.74,
  "text": "Bài học là:"
 },
 {
  "start": 61.74,
  "end": 62.49,
  "text": "chậm mà chắc,"
 },
 {
  "start": 62.49,
  "end": 65.57,
  "text": "còn hơn nhanh mà chủ quan."
 },
 {
  "start": 65.57,
  "end": 67.04,
  "text": "Giỏi đến đâu mà kiêu ngạo,"
 },
 {
  "start": 67.04,
  "end": 67.75,
  "text": "cũng có thể thua."
 },
 {
  "start": 67.75,
  "end": 70.05,
  "text": "Còn bạn, bạn giống Rùa"
 },
 {
  "start": 70.05,
  "end": 70.72,
  "text": "hay giống Thỏ?"
 },
 {
  "start": 70.72,
  "end": 72.17,
  "text": "Bình luận cho mình biết nhé!"
 }
]