[
 {
  "start": 0.0,
  "end": 1.69,
  "text": "Ê, tới Cần Thơ mà"
 },
 {
  "start": 1.69,
  "end": 3.96,
  "text": "chưa biết chỗ nào lai rai ngon hả?"
 },
 {
  "start": 3.96,
  "end": 4.78,
  "text": "Đứng yên đó,"
 },
 {
  "start": 4.78,
  "end": 6.3,
  "text": "để tui chỉ cho."
 },
 {
  "start": 6.3,
  "end": 7.01,
  "text": "Từ Bến Ninh Kiều,"
 },
 {
  "start": 7.01,
  "end": 8.69,
  "text": "chạy lên Hai Bà Trưng,"
 },
 {
  "start": 8.69,
  "end": 9.3,
  "text": "dọc bờ sông."
 },
 {
  "start": 9.3,
  "end": 11.66,
  "text": "Tới Ngô Gia Tự thì quẹo trái."
 },
 {
  "start": 11.66,
  "end": 12.03,
  "text": "Chạy thẳng,"
 },
 {
  "start": 12.03,
  "end": 12.94,
  "text": "băng qua đường Hòa Bình."
 },
 {
  "start": 12.94,
  "end": 14.42,
  "text": "Tới góc Nguyễn Đình Chiểu,"
 },
 {
  "start": 14.42,
  "end": 15.57,
  "text": "ngó qua tay phải..."
 },
 {
  "start": 15.57,
  "end": 17.1,
  "text": "Tới rồi đó!"
 },
 {
  "start": 17.1,
  "end": 17.86,
  "text": "Quán Cóc,"
 },
 {
  "start": 17.86,
  "end": 19.47,
  "text": "số 16 Nguyễn Đình Chiểu,"
 },
 {
  "start": 19.47,
  "end": 22.81,
  "text": "cách bến chưa tới 500 mét."
 },
 {
  "start": 22.81,
  "end": 23.73,
  "text": "Món bình dân thôi,"
 },
 {
  "start": 23.73,
  "end": 25.32,
  "text": "mà món nào cũng cuốn."
 },
 {
  "start": 25.32,
  "end": 26.49,
  "text": "Chân gà chiên nè."
 },
 {
  "start": 26.49,
  "end": 26.83,
  "text": "Ốc nè."
 },
 {
  "start": 26.83,
  "end": 27.99,
  "text": "Khô mực chiên tiêu nè."
 },
 {
  "start": 27.99,
  "end": 29.4,
  "text": "Khoai cao chiên nước mắm."
 },
 {
  "start": 29.4,
  "end": 31.31,
  "text": "Khổ qua chà bông, mát rượi."
 },
 {
  "start": 31.31,
  "end": 32.15,
  "text": "Bò lúc lắc."
 },
 {
  "start": 32.15,
  "end": 33.53,
  "text": "Hột vịt lộn xào me..."
 },
 {
  "start": 33.53,
  "end": 34.34,
  "text": "kể hoài không hết."
 },
 {
  "start": 34.34,
  "end": 36.75,
  "text": "À mà khoan, có tin vui nè!"
 },
 {
  "start": 36.75,
  "end": 38.9,
  "text": "Từ 22/11 tới 6/12,"
 },
 {
  "start": 38.9,
  "end": 40.53,
  "text": "hóa đơn 500 nghìn,"
 },
 {
  "start": 40.53,
  "end": 42.02,
  "text": "tặng liền một dĩa bò viên."
 },
 {
  "start": 42.02,
  "end": 43.19,
  "text": "Hóa đơn 1 triệu rưỡi,"
 },
 {
  "start": 43.19,
  "end": 44.89,
  "text": "tặng luôn một dĩa sườn bò."
 },
 {
  "start": 44.89,
  "end": 45.48,
  "text": "Rủ cạ cứng"
 },
 {
  "start": 45.48,
  "end": 46.65,
  "text": "ghé Quán Cóc liền nha!"
 }
]