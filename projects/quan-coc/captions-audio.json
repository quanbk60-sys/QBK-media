[
 {
  "start": 0.31,
  "end": 1.35,
  "text": "Tối nay rảnh không?"
 },
 {
  "start": 1.35,
  "end": 3.69,
  "text": "Ghé Cần Thơ, lai rai chút nè."
 },
 {
  "start": 3.69,
  "end": 5.44,
  "text": "Từ Bến Ninh Kiều,"
 },
 {
  "start": 5.44,
  "end": 6.82,
  "text": "chạy lên Hai Bà Trưng,"
 },
 {
  "start": 6.82,
  "end": 8.37,
  "text": "dọc bờ sông."
 },
 {
  "start": 8.37,
  "end": 10.15,
  "text": "Tới Ngô Gia Tự thì quẹo trái."
 },
 {
  "start": 10.15,
  "end": 11.2,
  "text": "Chạy thẳng,"
 },
 {
  "start": 11.2,
  "end": 12.54,
  "text": "qua đường Hòa Bình."
 },
 {
  "start": 12.54,
  "end": 13.91,
  "text": "Tới góc Nguyễn Đình Chiểu,"
 },
 {
  "start": 13.91,
  "end": 15.12,
  "text": "ngó qua tay phải..."
 },
 {
  "start": 15.12,
  "end": 15.76,
  "text": "là tới rồi."
 },
 {
  "start": 15.76,
  "end": 17.21,
  "text": "Quán Cóc,"
 },
 {
  "start": 17.21,
  "end": 18.62,
  "text": "số 16 Nguyễn Đình Chiểu."
 },
 {
  "start": 18.62,
  "end": 21.23,
  "text": "Cách bến chưa tới 500 mét."
 },
 {
  "start": 21.23,
  "end": 22.28,
  "text": "Chiều chiều ngồi đây,"
 },
 {
  "start": 22.28,
  "end": 23.43,
  "text": "ngó phố lên đèn."
 },
 {
  "start": 23.43,
  "end": 25.22,
  "text": "Gọi dĩa chân gà chiên,"
 },
 {
  "start": 25.22,
  "end": 25.92,
  "text": "dĩa ốc,"
 },
 {
  "start": 25.92,
  "end": 27.15,
  "text": "khô mực chiên tiêu."
 },
 {
  "start": 27.15,
  "end": 29.04,
  "text": "Thêm khoai cao chiên nước mắm,"
 },
 {
  "start": 29.04,
  "end": 30.25,
  "text": "khổ qua chà bông,"
 },
 {
  "start": 30.25,
  "end": 31.13,
  "text": "bò lúc lắc,"
 },
 {
  "start": 31.13,
  "end": 33.28,
  "text": "hột vịt lộn xào me."
 },
 {
  "start": 33.28,
  "end": 34.38,
  "text": "Trời mưa cũng chẳng sao,"
 },
 {
  "start": 34.38,
  "end": 36.14,
  "text": "ngồi nghe mưa với bạn bè"
 },
 {
  "start": 36.14,
  "end": 36.79,
  "text": "là vui rồi."
 },
 {
  "start": 36.79,
  "end": 40.37,
  "text": "À, từ 22/11 tới 6/12,"
 },
 {
  "start": 40.37,
  "end": 42.1,
  "text": "hóa đơn 500 nghìn,"
 },
 {
  "start": 42.1,
  "end": 43.35,
  "text": "quán tặng một dĩa bò viên."
 },
 {
  "start": 43.35,
  "end": 45.28,
  "text": "Hóa đơn 1 triệu rưỡi,"
 },
 {
  "start": 45.28,
  "end": 46.8,
  "text": "tặng một dĩa sườn bò."
 },
 {
  "start": 46.8,
  "end": 47.86,
  "text": "Rảnh thì ghé Quán Cóc"
 },
 {
  "start": 47.86,
  "end": 48.81,
  "text": "ngồi chơi nha."
 }
]