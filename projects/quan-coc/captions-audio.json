[
 {
  "start": 0.23,
  "end": 1.18,
  "text": "Tối nay rảnh không?"
 },
 {
  "start": 1.18,
  "end": 2.78,
  "text": "Ghé Cần Thơ, lai rai chút nè."
 },
 {
  "start": 2.78,
  "end": 3.73,
  "text": "Từ Bến Ninh Kiều,"
 },
 {
  "start": 3.73,
  "end": 4.88,
  "text": "chạy lên Hai Bà Trưng,"
 },
 {
  "start": 4.88,
  "end": 5.58,
  "text": "dọc bờ sông."
 },
 {
  "start": 5.58,
  "end": 7.13,
  "text": "Tới Ngô Gia Tự thì quẹo trái."
 },
 {
  "start": 7.13,
  "end": 8.19,
  "text": "Chạy thẳng,"
 },
 {
  "start": 8.19,
  "end": 9.58,
  "text": "qua đường Hòa Bình."
 },
 {
  "start": 9.58,
  "end": 10.99,
  "text": "Tới góc Nguyễn Đình Chiểu,"
 },
 {
  "start": 10.99,
  "end": 12.49,
  "text": "ngó qua tay phải..."
 },
 {
  "start": 12.49,
  "end": 13.85,
  "text": "là tới rồi."
 },
 {
  "start": 13.85,
  "end": 14.44,
  "text": "Quán Cóc,"
 },
 {
  "start": 14.44,
  "end": 16.52,
  "text": "số 16 Nguyễn Đình Chiểu."
 },
 {
  "start": 16.52,
  "end": 20.14,
  "text": "Cách bến chưa tới 500 mét."
 },
 {
  "start": 20.14,
  "end": 21.55,
  "text": "Chiều chiều ngồi đây,"
 },
 {
  "start": 21.55,
  "end": 23.42,
  "text": "ngó phố lên đèn."
 },
 {
  "start": 23.42,
  "end": 24.7,
  "text": "Trời mưa cũng chẳng sao,"
 },
 {
  "start": 24.7,
  "end": 27.45,
  "text": "ngồi nghe mưa với bạn bè"
 },
 {
  "start": 27.45,
  "end": 28.18,
  "text": "là vui rồi."
 },
 {
  "start": 28.18,
  "end": 32.66,
  "text": "À, từ 22/11 tới 6/12,"
 },
 {
  "start": 32.66,
  "end": 35.39,
  "text": "hóa đơn 500 nghìn,"
 },
 {
  "start": 35.39,
  "end": 37.93,
  "text": "quán tặng một dĩa bò viên."
 },
 {
  "start": 37.93,
  "end": 39.43,
  "text": "Hóa đơn 1 triệu rưỡi,"
 },
 {
  "start": 39.43,
  "end": 41.81,
  "text": "tặng một dĩa sườn bò."
 },
 {
  "start": 41.81,
  "end": 42.79,
  "text": "Rảnh thì ghé Quán Cóc"
 },
 {
  "start": 42.79,
  "end": 43.44,
  "text": "ngồi chơi nha."
 }
]