[
 {
  "start": 0.2,
  "end": 1.34,
  "text": "Ê, tới Cần Thơ mà"
 },
 {
  "start": 1.34,
  "end": 3.01,
  "text": "chưa biết chỗ nào lai rai ngon hả?"
 },
 {
  "start": 3.01,
  "end": 3.81,
  "text": "Đứng yên đó,"
 },
 {
  "start": 3.81,
  "end": 4.42,
  "text": "để tui chỉ cho!"
 },
 {
  "start": 4.42,
  "end": 5.84,
  "text": "Đây là Bến Ninh Kiều nè."
 },
 {
  "start": 5.84,
  "end": 7.24,
  "text": "Chạy lên đường Hai Bà Trưng,"
 },
 {
  "start": 7.24,
  "end": 8.2,
  "text": "dọc theo bờ sông."
 },
 {
  "start": 8.2,
  "end": 9.74,
  "text": "Tới Ngô Gia Tự thì quẹo trái."
 },
 {
  "start": 9.74,
  "end": 10.83,
  "text": "Chạy thẳng,"
 },
 {
  "start": 10.83,
  "end": 11.58,
  "text": "băng qua đường Hòa Bình."
 },
 {
  "start": 11.58,
  "end": 12.8,
  "text": "Tới góc Nguyễn Đình Chiểu,"
 },
 {
  "start": 12.8,
  "end": 13.55,
  "text": "ngó qua tay phải."
 },
 {
  "start": 13.55,
  "end": 14.68,
  "text": "Tới rồi đó!"
 },
 {
  "start": 14.68,
  "end": 16.33,
  "text": "Từ bến lên chừng 500 mét,"
 },
 {
  "start": 16.33,
  "end": 17.82,
  "text": "chạy xe cái vèo là tới."
 },
 {
  "start": 17.82,
  "end": 18.53,
  "text": "Quán Cóc,"
 },
 {
  "start": 18.53,
  "end": 19.58,
  "text": "số 16 Nguyễn Đình Chiểu."
 },
 {
  "start": 19.58,
  "end": 21.24,
  "text": "Toàn món nhậu bình dân thôi à."
 },
 {
  "start": 21.24,
  "end": 22.76,
  "text": "Bò lúc lắc khoai tây nè."
 },
 {
  "start": 22.76,
  "end": 23.89,
  "text": "Khô mực chiên tiêu,"
 },
 {
  "start": 23.89,
  "end": 24.78,
  "text": "nhai giòn rụm."
 },
 {
  "start": 24.78,
  "end": 25.8,
  "text": "Hột vịt lộn xào me,"
 },
 {
  "start": 25.8,
  "end": 26.85,
  "text": "đậu hũ chiên sả."
 },
 {
  "start": 26.85,
  "end": 27.85,
  "text": "Thêm tô nghêu nấu Thái nữa"
 },
 {
  "start": 27.85,
  "end": 28.35,
  "text": "là hết sẩy."
 },
 {
  "start": 28.35,
  "end": 29.66,
  "text": "Mà khoan, tin nóng nè!"
 },
 {
  "start": 29.66,
  "end": 32.77,
  "text": "Từ 22/11 tới 6/12,"
 },
 {
  "start": 32.77,
  "end": 34.2,
  "text": "hóa đơn 500 nghìn,"
 },
 {
  "start": 34.2,
  "end": 35.67,
  "text": "tặng liền một dĩa bò viên."
 },
 {
  "start": 35.67,
  "end": 36.68,
  "text": "Hóa đơn 1 triệu rưỡi,"
 },
 {
  "start": 36.68,
  "end": 38.22,
  "text": "tặng luôn một dĩa sườn bò!"
 },
 {
  "start": 38.22,
  "end": 39.05,
  "text": "Rủ cạ cứng đi liền,"
 },
 {
  "start": 39.05,
  "end": 39.86,
  "text": "kẻo hết chương trình nha."
 },
 {
  "start": 39.86,
  "end": 41.2,
  "text": "Mà nhớ, có uống"
 },
 {
  "start": 41.2,
  "end": 42.11,
  "text": "thì đừng lái xe đó!"
 }
]