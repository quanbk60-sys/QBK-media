[
 {
  "start": 0.0,
  "end": 1.56,
  "text": "Tối nay rảnh không?"
 },
 {
  "start": 1.56,
  "end": 3.53,
  "text": "Ghé Cần Thơ, lai rai chút nè."
 },
 {
  "start": 3.53,
  "end": 4.48,
  "text": "Từ Bến Ninh Kiều,"
 },
 {
  "start": 4.48,
  "end": 5.82,
  "text": "chạy lên Hai Bà Trưng,"
 },
 {
  "start": 5.82,
  "end": 7.03,
  "text": "dọc bờ sông."
 },
 {
  "start": 7.03,
  "end": 8.5,
  "text": "Tới Ngô Gia Tự thì quẹo trái."
 },
 {
  "start": 8.5,
  "end": 9.51,
  "text": "Chạy thẳng,"
 },
 {
  "start": 9.51,
  "end": 10.54,
  "text": "qua đường Hòa Bình."
 },
 {
  "start": 10.54,
  "end": 12.3,
  "text": "Tới góc Nguyễn Đình Chiểu,"
 },
 {
  "start": 12.3,
  "end": 13.27,
  "text": "ngó qua tay phải..."
 },
 {
  "start": 13.27,
  "end": 14.72,
  "text": "là tới rồi."
 },
 {
  "start": 14.72,
  "end": 15.4,
  "text": "Quán Cóc,"
 },
 {
  "start": 15.4,
  "end": 16.69,
  "text": "số 16 Nguyễn Đình Chiểu."
 },
 {
  "start": 16.69,
  "end": 18.64,
  "text": "Cách bến chưa tới 500 mét."
 },
 {
  "start": 18.64,
  "end": 20.17,
  "text": "Chiều chiều ngồi đây,"
 },
 {
  "start": 20.17,
  "end": 21.4,
  "text": "ngó phố lên đèn."
 },
 {
  "start": 21.4,
  "end": 23.0,
  "text": "Trời mưa cũng chẳng sao,"
 },
 {
  "start": 23.0,
  "end": 24.1,
  "text": "ngồi nghe mưa với bạn bè"
 },
 {
  "start": 24.1,
  "end": 25.24,
  "text": "là vui rồi."
 },
 {
  "start": 25.24,
  "end": 27.38,
  "text": "À, từ 22/11 tới 6/12,"
 },
 {
  "start": 27.38,
  "end": 29.64,
  "text": "hóa đơn 500 nghìn,"
 },
 {
  "start": 29.64,
  "end": 31.41,
  "text": "quán tặng một dĩa bò viên."
 },
 {
  "start": 31.41,
  "end": 32.44,
  "text": "Hóa đơn 1 triệu rưỡi,"
 },
 {
  "start": 32.44,
  "end": 33.34,
  "text": "tặng một dĩa sườn bò."
 },
 {
  "start": 33.34,
  "end": 34.81,
  "text": "Rảnh thì ghé Quán Cóc"
 },
 {
  "start": 34.81,
  "end": 35.42,
  "text": "ngồi chơi nha."
 }
]