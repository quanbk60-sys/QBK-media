[
 {
  "start": 0.24,
  "end": 1.57,
  "text": "Ê ê! Tới Cần Thơ mà"
 },
 {
  "start": 1.57,
  "end": 2.96,
  "text": "chưa biết chỗ nào lai rai ngon hả?"
 },
 {
  "start": 2.96,
  "end": 4.37,
  "text": "Đứng yên đó,"
 },
 {
  "start": 4.37,
  "end": 5.54,
  "text": "tui chỉ cho nè!"
 },
 {
  "start": 5.54,
  "end": 6.83,
  "text": "Từ Bến Ninh Kiều,"
 },
 {
  "start": 6.83,
  "end": 7.64,
  "text": "chạy lên Hai Bà Trưng,"
 },
 {
  "start": 7.64,
  "end": 8.12,
  "text": "dọc bờ sông."
 },
 {
  "start": 8.12,
  "end": 9.68,
  "text": "Tới Ngô Gia Tự, quẹo trái."
 },
 {
  "start": 9.68,
  "end": 10.28,
  "text": "Chạy thẳng,"
 },
 {
  "start": 10.28,
  "end": 11.18,
  "text": "băng qua đường Hòa Bình."
 },
 {
  "start": 11.18,
  "end": 12.51,
  "text": "Tới góc Nguyễn Đình Chiểu,"
 },
 {
  "start": 12.51,
  "end": 13.23,
  "text": "ngó qua tay phải..."
 },
 {
  "start": 13.23,
  "end": 14.42,
  "text": "Tới rồi đó!"
 },
 {
  "start": 14.42,
  "end": 15.04,
  "text": "Quán Cóc,"
 },
 {
  "start": 15.04,
  "end": 16.36,
  "text": "số 16 Nguyễn Đình Chiểu,"
 },
 {
  "start": 16.36,
  "end": 18.19,
  "text": "chưa tới 500 mét từ bến."
 },
 {
  "start": 18.19,
  "end": 19.01,
  "text": "Món bình dân mà"
 },
 {
  "start": 19.01,
  "end": 20.12,
  "text": "món nào cũng cuốn nha!"
 },
 {
  "start": 20.12,
  "end": 21.47,
  "text": "Chân gà chiên nè,"
 },
 {
  "start": 21.47,
  "end": 22.13,
  "text": "ốc nè,"
 },
 {
  "start": 22.13,
  "end": 23.4,
  "text": "khô mực chiên tiêu nè!"
 },
 {
  "start": 23.4,
  "end": 24.51,
  "text": "Khoai môn chiên giòn rụm,"
 },
 {
  "start": 24.51,
  "end": 25.88,
  "text": "khổ qua chà bông mát rượi."
 },
 {
  "start": 25.88,
  "end": 26.85,
  "text": "Bò lúc lắc,"
 },
 {
  "start": 26.85,
  "end": 27.89,
  "text": "hột vịt lộn xào me..."
 },
 {
  "start": 27.89,
  "end": 28.85,
  "text": "kể hoài không hết!"
 },
 {
  "start": 28.85,
  "end": 29.85,
  "text": "Mà khoan, tin nóng!"
 },
 {
  "start": 29.85,
  "end": 32.4,
  "text": "Từ 22/11 tới 6/12,"
 },
 {
  "start": 32.4,
  "end": 33.85,
  "text": "hóa đơn 500 nghìn,"
 },
 {
  "start": 33.85,
  "end": 34.92,
  "text": "tặng liền một dĩa bò viên."
 },
 {
  "start": 34.92,
  "end": 35.96,
  "text": "Hóa đơn 1 triệu rưỡi,"
 },
 {
  "start": 35.96,
  "end": 37.16,
  "text": "tặng luôn một dĩa sườn bò!"
 },
 {
  "start": 37.16,
  "end": 38.84,
  "text": "Rủ cạ cứng đi liền đi!"
 },
 {
  "start": 38.84,
  "end": 40.13,
  "text": "Mà nhớ nha, có uống"
 },
 {
  "start": 40.13,
  "end": 41.13,
  "text": "thì đừng lái xe đó!"
 }
]