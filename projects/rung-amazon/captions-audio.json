[
 {
  "start": 0.18,
  "end": 0.98,
  "text": "Rừng Amazon không phải"
 },
 {
  "start": 0.98,
  "end": 2.35,
  "text": "lá phổi của Trái Đất."
 },
 {
  "start": 2.35,
  "end": 3.04,
  "text": "Chuyện nó tạo ra"
 },
 {
  "start": 3.04,
  "end": 3.94,
  "text": "hai mươi phần trăm ô-xy"
 },
 {
  "start": 3.94,
  "end": 4.46,
  "text": "là ngộ nhận."
 },
 {
  "start": 4.46,
  "end": 5.99,
  "text": "Cây và vi sinh vật trong rừng"
 },
 {
  "start": 5.99,
  "end": 8.46,
  "text": "dùng lại gần hết số ô-xy đó."
 },
 {
  "start": 8.46,
  "end": 9.18,
  "text": "Nhưng Amazon làm được"
 },
 {
  "start": 9.18,
  "end": 10.05,
  "text": "một việc lạ hơn nhiều."
 },
 {
  "start": 10.05,
  "end": 11.78,
  "text": "Vùng Amazon rộng khoảng"
 },
 {
  "start": 11.78,
  "end": 12.58,
  "text": "sáu phẩy bảy triệu"
 },
 {
  "start": 12.58,
  "end": 12.93,
  "text": "ki-lô-mét vuông,"
 },
 {
  "start": 12.93,
  "end": 13.98,
  "text": "gấp chừng hai mươi lần"
 },
 {
  "start": 13.98,
  "end": 14.36,
  "text": "Việt Nam,"
 },
 {
  "start": 14.36,
  "end": 15.65,
  "text": "trải trên chín quốc gia"
 },
 {
  "start": 15.65,
  "end": 16.37,
  "text": "và vùng lãnh thổ."
 },
 {
  "start": 16.37,
  "end": 17.5,
  "text": "Ở đây có khoảng"
 },
 {
  "start": 17.5,
  "end": 18.76,
  "text": "ba trăm chín mươi tỷ cây,"
 },
 {
  "start": 18.76,
  "end": 19.55,
  "text": "và ít nhất một phần mười"
 },
 {
  "start": 19.55,
  "end": 21.08,
  "text": "số loài đã biết trên Trái Đất."
 },
 {
  "start": 21.08,
  "end": 22.11,
  "text": "Sông Amazon đổ ra biển"
 },
 {
  "start": 22.11,
  "end": 22.91,
  "text": "khoảng một phần năm"
 },
 {
  "start": 22.91,
  "end": 24.17,
  "text": "lượng nước sông cả thế giới."
 },
 {
  "start": 24.17,
  "end": 25.15,
  "text": "Vậy mà trên trời"
 },
 {
  "start": 25.15,
  "end": 26.79,
  "text": "còn một dòng sông lớn hơn."
 },
 {
  "start": 26.79,
  "end": 27.79,
  "text": "Cây hút nước từ đất,"
 },
 {
  "start": 27.79,
  "end": 29.36,
  "text": "rồi thở hơi nước ra qua lá."
 },
 {
  "start": 29.36,
  "end": 30.84,
  "text": "Theo một ước tính khoa học,"
 },
 {
  "start": 30.84,
  "end": 31.73,
  "text": "cả khu rừng đẩy lên trời"
 },
 {
  "start": 31.73,
  "end": 32.63,
  "text": "khoảng hai mươi tỷ tấn nước"
 },
 {
  "start": 32.63,
  "end": 33.31,
  "text": "mỗi ngày,"
 },
 {
  "start": 33.31,
  "end": 34.39,
  "text": "nhiều hơn mười bảy tỷ tấn"
 },
 {
  "start": 34.39,
  "end": 35.25,
  "text": "sông Amazon đổ ra biển."
 },
 {
  "start": 35.25,
  "end": 36.93,
  "text": "Gió mang hơi nước ấy đi xa,"
 },
 {
  "start": 36.93,
  "end": 37.28,
  "text": "thành mưa"
 },
 {
  "start": 37.28,
  "end": 38.13,
  "text": "cho nhiều vùng Nam Mỹ."
 },
 {
  "start": 38.13,
  "end": 40.41,
  "text": "Người ta gọi nó là sông bay."
 },
 {
  "start": 40.41,
  "end": 40.76,
  "text": "Nhưng khoảng"
 },
 {
  "start": 40.76,
  "end": 41.86,
  "text": "mười bảy phần trăm rừng Amazon"
 },
 {
  "start": 41.86,
  "end": 42.4,
  "text": "đã mất hẳn."
 },
 {
  "start": 42.4,
  "end": 43.15,
  "text": "Mất cây,"
 },
 {
  "start": 43.15,
  "end": 44.03,
  "text": "sông bay cũng yếu dần."
 },
 {
  "start": 44.03,
  "end": 45.23,
  "text": "Bạn từng tin Amazon"
 },
 {
  "start": 45.23,
  "end": 45.97,
  "text": "là lá phổi xanh chứ?"
 },
 {
  "start": 45.97,
  "end": 46.96,
  "text": "Bình luận cho mình biết nhé."
 }
]