[
 {
  "start": 0.0,
  "end": 0.8,
  "text": "Nhìn từ vũ trụ,"
 },
 {
  "start": 0.8,
  "end": 2.28,
  "text": "nó chỉ là một vệt nước nhỏ."
 },
 {
  "start": 2.28,
  "end": 4.05,
  "text": "Nhưng dòng sông này gắn với"
 },
 {
  "start": 4.05,
  "end": 5.98,
  "text": "ba lần đánh bại quân xâm lược."
 },
 {
  "start": 5.98,
  "end": 6.53,
  "text": "Sông Bạch Đằng,"
 },
 {
  "start": 6.53,
  "end": 7.79,
  "text": "giữa Quảng Ninh và Hải Phòng."
 },
 {
  "start": 7.79,
  "end": 10.84,
  "text": "Lần thứ nhất, năm 938."
 },
 {
  "start": 10.84,
  "end": 12.78,
  "text": "Ngô Quyền đóng cọc gỗ bịt sắt"
 },
 {
  "start": 12.78,
  "end": 13.82,
  "text": "xuống lòng sông."
 },
 {
  "start": 13.82,
  "end": 14.84,
  "text": "Triều lên, cọc chìm,"
 },
 {
  "start": 14.84,
  "end": 16.48,
  "text": "ông nhử thủy quân Nam Hán"
 },
 {
  "start": 16.48,
  "end": 17.41,
  "text": "vào sâu."
 },
 {
  "start": 17.41,
  "end": 17.89,
  "text": "Triều rút,"
 },
 {
  "start": 17.89,
  "end": 19.98,
  "text": "thuyền giặc đâm cọc vỡ tan,"
 },
 {
  "start": 19.98,
  "end": 21.96,
  "text": "Lưu Hoằng Tháo bỏ mạng."
 },
 {
  "start": 21.96,
  "end": 24.04,
  "text": "Lần thứ hai, năm 981."
 },
 {
  "start": 24.04,
  "end": 24.94,
  "text": "Quân Tống kéo sang,"
 },
 {
  "start": 24.94,
  "end": 26.11,
  "text": "thủy quân tiến vào Bạch Đằng."
 },
 {
  "start": 26.11,
  "end": 27.86,
  "text": "Lê Hoàn đánh bại quân Tống,"
 },
 {
  "start": 27.86,
  "end": 29.98,
  "text": "tướng Hầu Nhân Bảo bị giết."
 },
 {
  "start": 29.98,
  "end": 31.92,
  "text": "Lần thứ ba, năm 1288,"
 },
 {
  "start": 31.92,
  "end": 33.24,
  "text": "quân Nguyên Mông."
 },
 {
  "start": 33.24,
  "end": 34.79,
  "text": "Trần Hưng Đạo dùng lại kế cũ:"
 },
 {
  "start": 34.79,
  "end": 35.82,
  "text": "cọc gỗ và thủy triều."
 },
 {
  "start": 35.82,
  "end": 37.48,
  "text": "Thuyền Nguyên bị giữ chân"
 },
 {
  "start": 37.48,
  "end": 38.48,
  "text": "đến khi nước ròng,"
 },
 {
  "start": 38.48,
  "end": 39.35,
  "text": "cọc nhô lên,"
 },
 {
  "start": 39.35,
  "end": 40.37,
  "text": "thuyền vỡ đắm hàng loạt."
 },
 {
  "start": 40.37,
  "end": 41.81,
  "text": "Tướng Nguyên Ô Mã Nhi"
 },
 {
  "start": 41.81,
  "end": 43.19,
  "text": "bị bắt sống."
 },
 {
  "start": 43.19,
  "end": 44.25,
  "text": "Và những chiếc cọc ấy vẫn còn."
 },
 {
  "start": 44.25,
  "end": 46.32,
  "text": "Ở Quảng Yên, khảo cổ tìm thấy"
 },
 {
  "start": 46.32,
  "end": 47.67,
  "text": "ba bãi cọc: Yên Giang,"
 },
 {
  "start": 47.67,
  "end": 49.87,
  "text": "Đồng Má Ngựa, Đồng Vạn Muối."
 },
 {
  "start": 49.87,
  "end": 50.92,
  "text": "Đo tuổi bằng các-bon phóng xạ:"
 },
 {
  "start": 50.92,
  "end": 51.96,
  "text": "thế kỷ mười ba,"
 },
 {
  "start": 51.96,
  "end": 53.13,
  "text": "khớp năm 1288."
 },
 {
  "start": 53.13,
  "end": 54.83,
  "text": "Ở Yên Giang, bạn còn"
 },
 {
  "start": 54.83,
  "end": 56.87,
  "text": "tận mắt thấy cọc lộ thiên."
 },
 {
  "start": 56.87,
  "end": 58.53,
  "text": "Một dòng sông, ba chiến thắng,"
 },
 {
  "start": 58.53,
  "end": 59.92,
  "text": "trải suốt ba trăm năm mươi năm."
 },
 {
  "start": 59.92,
  "end": 60.76,
  "text": "Theo bạn,"
 },
 {
  "start": 60.76,
  "end": 62.27,
  "text": "trận nào đáng nể nhất?"
 }
]