[
 {
  "start": 0.2,
  "end": 0.97,
  "text": "Chỉ một tờ giấy vuông,"
 },
 {
  "start": 0.97,
  "end": 2.6,
  "text": "không cắt, không dán,"
 },
 {
  "start": 2.6,
  "end": 4.23,
  "text": "bạn gấp được một chú chim."
 },
 {
  "start": 4.23,
  "end": 4.61,
  "text": "Bước một:"
 },
 {
  "start": 4.61,
  "end": 5.87,
  "text": "gấp đôi theo đường chéo,"
 },
 {
  "start": 5.87,
  "end": 6.94,
  "text": "rồi mở ra."
 },
 {
  "start": 6.94,
  "end": 7.59,
  "text": "Bước hai:"
 },
 {
  "start": 7.59,
  "end": 8.99,
  "text": "gấp hai mép vào đường giữa,"
 },
 {
  "start": 8.99,
  "end": 9.61,
  "text": "thành hình cánh diều."
 },
 {
  "start": 9.61,
  "end": 10.83,
  "text": "Bước ba:"
 },
 {
  "start": 10.83,
  "end": 12.13,
  "text": "gập đôi theo đường giữa,"
 },
 {
  "start": 12.13,
  "end": 13.71,
  "text": "miết nếp, rồi mở ra."
 },
 {
  "start": 13.71,
  "end": 14.16,
  "text": "Bước bốn:"
 },
 {
  "start": 14.16,
  "end": 16.16,
  "text": "miết thêm ba nếp ở hai đầu."
 },
 {
  "start": 16.16,
  "end": 16.89,
  "text": "Gập lại,"
 },
 {
  "start": 16.89,
  "end": 18.73,
  "text": "ấn đầu nhọn lộn vào trong làm cổ,"
 },
 {
  "start": 18.73,
  "end": 19.9,
  "text": "đỉnh cổ lộn tiếp làm đầu,"
 },
 {
  "start": 19.9,
  "end": 21.11,
  "text": "đầu kia làm đuôi."
 },
 {
  "start": 21.11,
  "end": 22.37,
  "text": "Bước năm:"
 },
 {
  "start": 22.37,
  "end": 23.92,
  "text": "hạ hai cánh sang hai bên."
 },
 {
  "start": 23.92,
  "end": 24.33,
  "text": "Xong rồi!"
 },
 {
  "start": 24.33,
  "end": 25.47,
  "text": "Giờ thả tay,"
 },
 {
  "start": 25.47,
  "end": 26.22,
  "text": "để chim bay qua"
 },
 {
  "start": 26.22,
  "end": 27.69,
  "text": "cánh đồng lúa chín vàng."
 },
 {
  "start": 27.69,
  "end": 28.06,
  "text": "Bạn sẽ gấp"
 },
 {
  "start": 28.06,
  "end": 28.66,
  "text": "con chim nào đầu tiên?"
 }
]