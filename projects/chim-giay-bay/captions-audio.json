[
 {
  "start": 0.2,
  "end": 0.969,
  "text": "Chỉ một tờ giấy vuông,"
 },
 {
  "start": 0.97,
  "end": 2.599,
  "text": "không cắt, không dán,"
 },
 {
  "start": 2.6,
  "end": 4.229,
  "text": "bạn gấp được một chú chim."
 },
 {
  "start": 4.53,
  "end": 4.909,
  "text": "Bước một:"
 },
 {
  "start": 4.91,
  "end": 6.169,
  "text": "gấp đôi theo đường chéo,"
 },
 {
  "start": 6.17,
  "end": 7.239,
  "text": "rồi mở ra."
 },
 {
  "start": 8.34,
  "end": 8.989,
  "text": "Bước hai:"
 },
 {
  "start": 8.99,
  "end": 10.389,
  "text": "gấp hai mép vào đường giữa,"
 },
 {
  "start": 10.39,
  "end": 11.009,
  "text": "thành hình cánh diều."
 },
 {
  "start": 12.31,
  "end": 13.529,
  "text": "Bước ba:"
 },
 {
  "start": 13.53,
  "end": 14.829,
  "text": "gập đôi theo đường giữa,"
 },
 {
  "start": 14.83,
  "end": 16.409,
  "text": "miết nếp, rồi mở ra."
 },
 {
  "start": 17.61,
  "end": 18.059,
  "text": "Bước bốn:"
 },
 {
  "start": 18.06,
  "end": 20.059,
  "text": "miết thêm ba nếp ở hai đầu."
 },
 {
  "start": 20.86,
  "end": 21.589,
  "text": "Gập lại,"
 },
 {
  "start": 21.59,
  "end": 23.429,
  "text": "ấn đầu nhọn lộn vào trong làm cổ,"
 },
 {
  "start": 23.73,
  "end": 24.899,
  "text": "đỉnh cổ lộn tiếp làm đầu,"
 },
 {
  "start": 24.9,
  "end": 26.109,
  "text": "đầu kia làm đuôi."
 },
 {
  "start": 27.51,
  "end": 28.769,
  "text": "Bước năm:"
 },
 {
  "start": 28.77,
  "end": 30.319,
  "text": "hạ hai cánh sang hai bên."
 },
 {
  "start": 31.52,
  "end": 31.929,
  "text": "Xong rồi!"
 },
 {
  "start": 31.93,
  "end": 33.069,
  "text": "Giờ thả tay,"
 },
 {
  "start": 33.07,
  "end": 33.819,
  "text": "để chim bay qua"
 },
 {
  "start": 33.82,
  "end": 35.289,
  "text": "cánh đồng lúa chín vàng."
 },
 {
  "start": 35.29,
  "end": 35.659,
  "text": "Bạn sẽ gấp"
 },
 {
  "start": 35.66,
  "end": 36.259,
  "text": "con chim nào đầu tiên?"
 }
]