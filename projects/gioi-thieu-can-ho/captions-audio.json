[
 {
  "start": 0.27,
  "end": 1.32,
  "text": "Bạn đang tìm một căn hộ"
 },
 {
  "start": 1.32,
  "end": 2.93,
  "text": "nhỏ xinh, ấm áp và đủ ánh sáng?"
 },
 {
  "start": 2.93,
  "end": 4.34,
  "text": "Căn hộ này nằm trong"
 },
 {
  "start": 4.34,
  "end": 5.58,
  "text": "khu dân cư Nam Long 2,"
 },
 {
  "start": 5.58,
  "end": 7.14,
  "text": "quận Cái Răng, Cần Thơ."
 },
 {
  "start": 7.14,
  "end": 9.01,
  "text": "Ngay lối vào là khoảng sảnh sáng sủa,"
 },
 {
  "start": 9.01,
  "end": 10.54,
  "text": "nền gạch xám dịu mắt."
 },
 {
  "start": 10.54,
  "end": 11.66,
  "text": "Cạnh cửa có chậu cây xanh"
 },
 {
  "start": 11.66,
  "end": 13.27,
  "text": "và chiếc ghế gỗ để ngồi thay giày."
 },
 {
  "start": 13.27,
  "end": 14.84,
  "text": "Tủ gỗ trắng gọn gàng,"
 },
 {
  "start": 14.84,
  "end": 15.89,
  "text": "bức tranh màu đất"
 },
 {
  "start": 15.89,
  "end": 16.69,
  "text": "và cành chanh vàng"
 },
 {
  "start": 16.69,
  "end": 18.07,
  "text": "dưới ánh đèn rọi rất tinh tế."
 },
 {
  "start": 18.07,
  "end": 20.48,
  "text": "Bước qua cổng vòm cong mềm mại,"
 },
 {
  "start": 20.48,
  "end": 22.26,
  "text": "không gian mở ra thoáng đãng."
 },
 {
  "start": 22.26,
  "end": 23.04,
  "text": "Phòng khách nhẹ nhàng"
 },
 {
  "start": 23.04,
  "end": 24.11,
  "text": "với sofa màu kem,"
 },
 {
  "start": 24.11,
  "end": 24.61,
  "text": "thảm họa tiết"
 },
 {
  "start": 24.61,
  "end": 25.89,
  "text": "và những chiếc gối hoa dễ thương."
 },
 {
  "start": 25.89,
  "end": 27.65,
  "text": "Góc ăn uống là điểm nhấn:"
 },
 {
  "start": 27.65,
  "end": 28.81,
  "text": "bàn gỗ bo tròn,"
 },
 {
  "start": 28.81,
  "end": 29.97,
  "text": "băng ghế dài ốp tường"
 },
 {
  "start": 29.97,
  "end": 30.87,
  "text": "và tấm thảm macramé"
 },
 {
  "start": 30.87,
  "end": 31.73,
  "text": "treo tường ấm cúng."
 },
 {
  "start": 31.73,
  "end": 33.37,
  "text": "Bếp chữ L liền kề,"
 },
 {
  "start": 33.37,
  "end": 34.73,
  "text": "tủ gỗ kết hợp tủ trắng,"
 },
 {
  "start": 34.73,
  "end": 36.42,
  "text": "đủ cho những bữa cơm nhà."
 },
 {
  "start": 36.42,
  "end": 38.35,
  "text": "Bên cửa sổ, kệ trắng với lọ hoa,"
 },
 {
  "start": 38.35,
  "end": 39.14,
  "text": "vài cuốn sách"
 },
 {
  "start": 39.14,
  "end": 40.05,
  "text": "và chiếc đèn xếp ly"
 },
 {
  "start": 40.05,
  "end": 42.06,
  "text": "tạo nên góc nhỏ đầy cảm hứng."
 },
 {
  "start": 42.06,
  "end": 43.51,
  "text": "Một căn hộ đẹp, ấm áp,"
 },
 {
  "start": 43.51,
  "end": 44.67,
  "text": "sẵn sàng đón người ở mới."
 },
 {
  "start": 44.67,
  "end": 45.76,
  "text": "Liên hệ ngay"
 },
 {
  "start": 45.76,
  "end": 46.87,
  "text": "để hẹn đến xem nhà nhé."
 }
]