[
 {
  "start": 0.65,
  "end": 2.23,
  "text": "An đứng lặng trước gương,"
 },
 {
  "start": 2.23,
  "end": 3.62,
  "text": "hai tay giấu sau lưng."
 },
 {
  "start": 3.62,
  "end": 4.81,
  "text": "Cô suy nghĩ rất lâu"
 },
 {
  "start": 4.81,
  "end": 6.08,
  "text": "về cuộc hẹn tối nay."
 },
 {
  "start": 6.48,
  "end": 8.33,
  "text": "Bỗng có tiếng động ngoài cửa."
 },
 {
  "start": 8.33,
  "end": 9.16,
  "text": "An khựng lại,"
 },
 {
  "start": 9.16,
  "end": 11.2,
  "text": "tay khẽ chạm lên sợi dây chuyền."
 },
 {
  "start": 11.6,
  "end": 12.2,
  "text": "Cô mở cửa,"
 },
 {
  "start": 12.2,
  "end": 14.56,
  "text": "bước ra hành lang khách sạn sang trọng."
 },
 {
  "start": 14.56,
  "end": 15.22,
  "text": "Ngoài sảnh,"
 },
 {
  "start": 15.22,
  "end": 16.31,
  "text": "có người đang chờ."
 },
 {
  "start": 16.71,
  "end": 17.87,
  "text": "An đi thật nhanh,"
 },
 {
  "start": 17.87,
  "end": 19.64,
  "text": "tay nắm chặt chiếc ví nhỏ."
 },
 {
  "start": 19.64,
  "end": 20.52,
  "text": "Thỉnh thoảng,"
 },
 {
  "start": 20.52,
  "end": 22.77,
  "text": "cô lại dè chừng nhìn về phía sau."
 },
 {
  "start": 23.17,
  "end": 25.01,
  "text": "Ở sảnh thang máy đông người qua lại,"
 },
 {
  "start": 25.01,
  "end": 26.65,
  "text": "cuộc trò chuyện diễn ra rất khẽ,"
 },
 {
  "start": 26.65,
  "end": 27.27,
  "text": "đầy lo lắng."
 },
 {
  "start": 27.67,
  "end": 28.65,
  "text": "Rồi An quay đi,"
 },
 {
  "start": 28.65,
  "end": 29.57,
  "text": "bước thật vội,"
 },
 {
  "start": 29.57,
  "end": 31.47,
  "text": "như sợ có ai đó nhận ra mình."
 }
]