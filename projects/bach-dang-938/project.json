 "captions": [
  {
   "start": 0.44,
   "end": 1.9,
   "text": "Năm 938,"
  },
  {
   "start": 1.9,
   "end": 3.0,
   "text": "có một trận thủy chiến"
  },
  {
   "start": 3.0,
   "end": 4.15,
   "text": "mà người thắng không cần"
  },
  {
   "start": 4.15,
   "end": 5.87,
   "text": "tự tay đánh chìm thuyền giặc."
  },
  {
   "start": 5.87,
   "end": 8.87,
   "text": "Thủy triều đã làm điều đó."
  },
  {
   "start": 8.87,
   "end": 10.37,
   "text": "Năm 937,"
  },
  {
   "start": 10.37,
   "end": 11.0,
   "text": "Kiều Công Tiễn"
  },
  {
   "start": 11.0,
   "end": 11.85,
   "text": "giết Dương Đình Nghệ"
  },
  {
   "start": 11.85,
   "end": 13.17,
   "text": "để cướp quyền."
  },
  {
   "start": 13.17,
   "end": 14.7,
   "text": "Con rể của ông là Ngô Quyền"
  },
  {
   "start": 14.7,
   "end": 16.2,
   "text": "lập tức kéo quân ra hỏi tội."
  },
  {
   "start": 16.2,
   "end": 18.52,
   "text": "Bị dồn vào thế cùng,"
  },
  {
   "start": 18.52,
   "end": 19.14,
   "text": "Kiều Công Tiễn"
  },
  {
   "start": 19.14,
   "end": 20.92,
   "text": "cầu cứu nhà Nam Hán."
  },
  {
   "start": 20.92,
   "end": 22.17,
   "text": "Vua Nam Hán sai con trai"
  },
  {
   "start": 22.17,
   "end": 23.34,
   "text": "là Lưu Hoằng Tháo"
  },
  {
   "start": 23.34,
   "end": 24.83,
   "text": "đem thủy quân sang,"
  },
  {
   "start": 24.83,
   "end": 26.06,
   "text": "còn mình đích thân đóng quân"
  },
  {
   "start": 26.06,
   "end": 27.28,
   "text": "ở Hải Môn để tiếp ứng."
  },
  {
   "start": 27.28,
   "end": 29.36,
   "text": "Nhưng chưa kịp đến nơi,"
  },
  {
   "start": 29.36,
   "end": 30.46,
   "text": "Kiều Công Tiễn"
  },
  {
   "start": 30.46,
   "end": 31.34,
   "text": "đã bị Ngô Quyền giết."
  },
  {
   "start": 31.34,
   "end": 34.18,
   "text": "Kẻ nội ứng không còn nữa."
  },
  {
   "start": 34.18,
   "end": 34.94,
   "text": "Ngô Quyền nhận định:"
  },
  {
   "start": 34.94,
   "end": 36.58,
   "text": "Hoằng Tháo còn non trẻ,"
  },
  {
   "start": 36.58,
   "end": 38.15,
   "text": "quân từ xa tới đã mỏi mệt."
  },
  {
   "start": 38.15,
   "end": 39.21,
   "text": "Muốn thắng,"
  },
  {
   "start": 39.21,
   "end": 42.24,
   "text": "phải chọn đúng nơi và đúng lúc."
  },
  {
   "start": 42.24,
   "end": 43.7,
   "text": "Ông chọn cửa sông Bạch Đằng."
  },
  {
   "start": 43.7,
   "end": 45.7,
   "text": "Quân sĩ đóng cọc gỗ lớn"
  },
  {
   "start": 45.7,
   "end": 46.72,
   "text": "xuống lòng sông,"
  },
  {
   "start": 46.72,
   "end": 47.96,
   "text": "đầu vạt nhọn, bịt sắt."
  },
  {
   "start": 47.96,
   "end": 51.14,
   "text": "Khi nước lên, bãi cọc chìm hẳn."
  },
  {
   "start": 51.14,
   "end": 51.78,
   "text": "Khi nước xuống,"
  },
  {
   "start": 51.78,
   "end": 54.68,
   "text": "cọc nhô lên như hàm răng."
  },
  {
   "start": 54.68,
   "end": 55.38,
   "text": "Lúc triều dâng,"
  },
  {
   "start": 55.38,
   "end": 56.87,
   "text": "thuyền nhẹ ra khiêu chiến,"
  },
  {
   "start": 56.87,
   "end": 59.01,
   "text": "rồi giả thua chạy vào."
  },
  {
   "start": 59.01,
   "end": 60.27,
   "text": "Hoằng Tháo đuổi theo,"
  },
  {
   "start": 60.27,
   "end": 61.06,
   "text": "vượt qua bãi cọc"
  },
  {
   "start": 61.06,
   "end": 62.82,
   "text": "mà không hề hay biết."
  },
  {
   "start": 62.82,
   "end": 64.06,
   "text": "Chờ nước rút,"
  },
  {
   "start": 64.06,
   "end": 64.49,
   "text": "Ngô Quyền"
  },
  {
   "start": 64.49,
   "end": 65.72,
   "text": "dốc toàn quân đánh trả."
  },
  {
   "start": 65.72,
   "end": 67.47,
   "text": "Thuyền giặc quay đầu,"
  },
  {
   "start": 67.47,
   "end": 70.11,
   "text": "đâm vào cọc, vỡ và lật."
  },
  {
   "start": 70.11,
   "end": 71.06,
   "text": "Hoằng Tháo bỏ mạng."
  },
  {
   "start": 71.06,
   "end": 72.5,
   "text": "Quân Nam Hán thua to."
  },
  {
   "start": 72.5,
   "end": 74.17,
   "text": "Ở Hải Môn,"
  },
  {
   "start": 74.17,
   "end": 75.63,
   "text": "vua Nam Hán nghe tin,"
  },
  {
   "start": 75.63,
   "end": 77.68,
   "text": "đành thu quân về nước."
  },
  {
   "start": 77.68,
   "end": 79.33,
   "text": "Mùa xuân năm 939,"
  },
  {
   "start": 79.33,
   "end": 80.85,
   "text": "Ngô Quyền xưng vương,"
  },
  {
   "start": 80.85,
   "end": 82.79,
   "text": "đóng đô ở Cổ Loa."
  },
  {
   "start": 82.79,
   "end": 84.23,
   "text": "Một bãi cọc và một con nước"
  },
  {
   "start": 84.23,
   "end": 87.24,
   "text": "đã mở ra thời kỳ độc lập lâu dài."
  },
  {
   "start": 87.24,
   "end": 87.6,
   "text": "Theo bạn,"
  },
  {
   "start": 87.6,
   "end": 89.58,
   "text": "điều gì làm nên chiến thắng này?"
  },
  {
   "start": 89.58,
   "end": 91.73,
   "text": "Cọc gỗ, thủy triều,"
  },
  {
   "start": 91.73,
   "end": 92.79,
   "text": "hay con người?"
  }
 ],
