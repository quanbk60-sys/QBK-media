[
 {
  "start": 0.29,
  "end": 1.75,
  "text": "Năm 938,",
  "at_pause": true
 },
 {
  "start": 1.75,
  "end": 2.85,
  "text": "có một trận thủy chiến",
  "at_pause": false
 },
 {
  "start": 2.85,
  "end": 4.0,
  "text": "mà người thắng không cần",
  "at_pause": false
 },
 {
  "start": 4.0,
  "end": 5.72,
  "text": "tự tay đánh chìm thuyền giặc.",
  "at_pause": true
 },
 {
  "start": 5.72,
  "end": 8.72,
  "text": "Thủy triều đã làm điều đó.",
  "at_pause": true
 },
 {
  "start": 8.72,
  "end": 10.22,
  "text": "Năm 937,",
  "at_pause": true
 },
 {
  "start": 10.22,
  "end": 10.85,
  "text": "Kiều Công Tiễn",
  "at_pause": false
 },
 {
  "start": 10.85,
  "end": 11.7,
  "text": "giết Dương Đình Nghệ",
  "at_pause": false
 },
 {
  "start": 11.7,
  "end": 13.02,
  "text": "để cướp quyền.",
  "at_pause": true
 },
 {
  "start": 13.02,
  "end": 14.55,
  "text": "Con rể của ông là Ngô Quyền",
  "at_pause": false
 },
 {
  "start": 14.55,
  "end": 16.05,
  "text": "lập tức kéo quân ra hỏi tội.",
  "at_pause": true
 },
 {
  "start": 16.05,
  "end": 18.37,
  "text": "Bị dồn vào thế cùng,",
  "at_pause": true
 },
 {
  "start": 18.37,
  "end": 18.99,
  "text": "Kiều Công Tiễn",
  "at_pause": false
 },
 {
  "start": 18.99,
  "end": 20.77,
  "text": "cầu cứu nhà Nam Hán.",
  "at_pause": true
 },
 {
  "start": 20.77,
  "end": 22.02,
  "text": "Vua Nam Hán sai con trai",
  "at_pause": true
 },
 {
  "start": 22.02,
  "end": 23.19,
  "text": "là Lưu Hoằng Tháo",
  "at_pause": false
 },
 {
  "start": 23.19,
  "end": 24.68,
  "text": "đem thủy quân sang,",
  "at_pause": true
 },
 {
  "start": 24.68,
  "end": 25.91,
  "text": "còn mình đích thân đóng quân",
  "at_pause": false
 },
 {
  "start": 25.91,
  "end": 27.13,
  "text": "ở Hải Môn để tiếp ứng.",
  "at_pause": true
 },
 {
  "start": 27.13,
  "end": 29.21,
  "text": "Nhưng chưa kịp đến nơi,",
  "at_pause": true
 },
 {
  "start": 29.21,
  "end": 30.31,
  "text": "Kiều Công Tiễn",
  "at_pause": false
 },
 {
  "start": 30.31,
  "end": 31.19,
  "text": "đã bị Ngô Quyền giết.",
  "at_pause": true
 },
 {
  "start": 31.19,
  "end": 34.03,
  "text": "Kẻ nội ứng không còn nữa.",
  "at_pause": true
 },
 {
  "start": 34.03,
  "end": 34.79,
  "text": "Ngô Quyền nhận định:",
  "at_pause": true
 },
 {
  "start": 34.79,
  "end": 36.43,
  "text": "Hoằng Tháo còn non trẻ,",
  "at_pause": true
 },
 {
  "start": 36.43,
  "end": 38.0,
  "text": "quân từ xa tới đã mỏi mệt.",
  "at_pause": true
 },
 {
  "start": 38.0,
  "end": 39.06,
  "text": "Muốn thắng,",
  "at_pause": false
 },
 {
  "start": 39.06,
  "end": 42.09,
  "text": "phải chọn đúng nơi và đúng lúc.",
  "at_pause": true
 },
 {
  "start": 42.09,
  "end": 43.55,
  "text": "Ông chọn cửa sông Bạch Đằng.",
  "at_pause": true
 },
 {
  "start": 43.55,
  "end": 45.55,
  "text": "Quân sĩ đóng cọc gỗ lớn",
  "at_pause": false
 },
 {
  "start": 45.55,
  "end": 46.57,
  "text": "xuống lòng sông,",
  "at_pause": true
 },
 {
  "start": 46.57,
  "end": 47.81,
  "text": "đầu vạt nhọn, bịt sắt.",
  "at_pause": true
 },
 {
  "start": 47.81,
  "end": 50.99,
  "text": "Khi nước lên, bãi cọc chìm hẳn.",
  "at_pause": true
 },
 {
  "start": 50.99,
  "end": 51.63,
  "text": "Khi nước xuống,",
  "at_pause": true
 },
 {
  "start": 51.63,
  "end": 54.53,
  "text": "cọc nhô lên như hàm răng.",
  "at_pause": true
 },
 {
  "start": 54.53,
  "end": 55.23,
  "text": "Lúc triều dâng,",
  "at_pause": true
 },
 {
  "start": 55.23,
  "end": 56.72,
  "text": "thuyền nhẹ ra khiêu chiến,",
  "at_pause": true
 },
 {
  "start": 56.72,
  "end": 58.86,
  "text": "rồi giả thua chạy vào.",
  "at_pause": true
 },
 {
  "start": 58.86,
  "end": 60.12,
  "text": "Hoằng Tháo đuổi theo,",
  "at_pause": true
 },
 {
  "start": 60.12,
  "end": 60.91,
  "text": "vượt qua bãi cọc",
  "at_pause": false
 },
 {
  "start": 60.91,
  "end": 62.67,
  "text": "mà không hề hay biết.",
  "at_pause": true
 },
 {
  "start": 62.67,
  "end": 63.91,
  "text": "Chờ nước rút,",
  "at_pause": true
 },
 {
  "start": 63.91,
  "end": 64.34,
  "text": "Ngô Quyền",
  "at_pause": false
 },
 {
  "start": 64.34,
  "end": 65.57,
  "text": "dốc toàn quân đánh trả.",
  "at_pause": true
 },
 {
  "start": 65.57,
  "end": 67.32,
  "text": "Thuyền giặc quay đầu,",
  "at_pause": true
 },
 {
  "start": 67.32,
  "end": 69.96,
  "text": "đâm vào cọc, vỡ và lật.",
  "at_pause": true
 },
 {
  "start": 69.96,
  "end": 70.91,
  "text": "Hoằng Tháo bỏ mạng.",
  "at_pause": true
 },
 {
  "start": 70.91,
  "end": 72.35,
  "text": "Quân Nam Hán thua to.",
  "at_pause": true
 },
 {
  "start": 72.35,
  "end": 74.02,
  "text": "Ở Hải Môn,",
  "at_pause": true
 },
 {
  "start": 74.02,
  "end": 75.48,
  "text": "vua Nam Hán nghe tin,",
  "at_pause": true
 },
 {
  "start": 75.48,
  "end": 77.53,
  "text": "đành thu quân về nước.",
  "at_pause": true
 },
 {
  "start": 77.53,
  "end": 79.18,
  "text": "Mùa xuân năm 939,",
  "at_pause": true
 },
 {
  "start": 79.18,
  "end": 80.7,
  "text": "Ngô Quyền xưng vương,",
  "at_pause": true
 },
 {
  "start": 80.7,
  "end": 82.64,
  "text": "đóng đô ở Cổ Loa.",
  "at_pause": true
 },
 {
  "start": 82.64,
  "end": 84.08,
  "text": "Một bãi cọc và một con nước",
  "at_pause": true
 },
 {
  "start": 84.08,
  "end": 87.09,
  "text": "đã mở ra thời kỳ độc lập lâu dài.",
  "at_pause": true
 },
 {
  "start": 87.09,
  "end": 87.45,
  "text": "Theo bạn,",
  "at_pause": true
 },
 {
  "start": 87.45,
  "end": 89.43,
  "text": "điều gì làm nên chiến thắng này?",
  "at_pause": true
 },
 {
  "start": 89.43,
  "end": 91.58,
  "text": "Cọc gỗ, thủy triều,",
  "at_pause": true
 },
 {
  "start": 91.58,
  "end": 92.64,
  "text": "hay con người?",
  "at_pause": true
 }
]