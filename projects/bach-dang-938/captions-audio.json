[
 {
  "start": 0.29,
  "end": 1.75,
  "text": "Năm 938,"
 },
 {
  "start": 1.75,
  "end": 2.9,
  "text": "có một trận thủy chiến"
 },
 {
  "start": 2.9,
  "end": 4.0,
  "text": "mà người thắng không cần"
 },
 {
  "start": 4.0,
  "end": 5.72,
  "text": "tự tay đánh chìm thuyền giặc."
 },
 {
  "start": 5.72,
  "end": 8.72,
  "text": "Thủy triều đã làm điều đó."
 },
 {
  "start": 8.72,
  "end": 10.22,
  "text": "Năm 937,"
 },
 {
  "start": 10.22,
  "end": 10.85,
  "text": "Kiều Công Tiễn"
 },
 {
  "start": 10.85,
  "end": 11.7,
  "text": "giết Dương Đình Nghệ"
 },
 {
  "start": 11.7,
  "end": 13.02,
  "text": "để cướp quyền."
 },
 {
  "start": 13.02,
  "end": 14.55,
  "text": "Con rể của ông là Ngô Quyền"
 },
 {
  "start": 14.55,
  "end": 16.05,
  "text": "lập tức kéo quân ra hỏi tội."
 },
 {
  "start": 16.05,
  "end": 18.37,
  "text": "Bị dồn vào thế cùng,"
 },
 {
  "start": 18.37,
  "end": 18.99,
  "text": "Kiều Công Tiễn"
 },
 {
  "start": 18.99,
  "end": 20.77,
  "text": "cầu cứu nhà Nam Hán."
 },
 {
  "start": 20.77,
  "end": 22.02,
  "text": "Vua Nam Hán sai con trai"
 },
 {
  "start": 22.02,
  "end": 23.19,
  "text": "là Lưu Hoằng Tháo"
 },
 {
  "start": 23.19,
  "end": 24.68,
  "text": "đem thủy quân sang,"
 },
 {
  "start": 24.68,
  "end": 25.91,
  "text": "còn mình đích thân đóng quân"
 },
 {
  "start": 25.91,
  "end": 27.13,
  "text": "ở Hải Môn để tiếp ứng."
 },
 {
  "start": 27.13,
  "end": 29.21,
  "text": "Nhưng chưa kịp đến nơi,"
 },
 {
  "start": 29.21,
  "end": 30.31,
  "text": "Kiều Công Tiễn"
 },
 {
  "start": 30.31,
  "end": 31.19,
  "text": "đã bị Ngô Quyền giết."
 },
 {
  "start": 31.19,
  "end": 34.03,
  "text": "Kẻ nội ứng không còn nữa."
 },
 {
  "start": 34.03,
  "end": 34.79,
  "text": "Ngô Quyền nhận định:"
 },
 {
  "start": 34.79,
  "end": 36.43,
  "text": "Hoằng Tháo còn non trẻ,"
 },
 {
  "start": 36.43,
  "end": 38.0,
  "text": "quân từ xa tới đã mỏi mệt."
 },
 {
  "start": 38.0,
  "end": 39.06,
  "text": "Muốn thắng,"
 },
 {
  "start": 39.06,
  "end": 42.09,
  "text": "phải chọn đúng nơi và đúng lúc."
 },
 {
  "start": 42.09,
  "end": 43.55,
  "text": "Ông chọn cửa sông Bạch Đằng."
 },
 {
  "start": 43.55,
  "end": 45.55,
  "text": "Quân sĩ đóng cọc gỗ lớn"
 },
 {
  "start": 45.55,
  "end": 46.57,
  "text": "xuống lòng sông,"
 },
 {
  "start": 46.57,
  "end": 47.81,
  "text": "đầu vạt nhọn, bịt sắt."
 },
 {
  "start": 47.81,
  "end": 50.99,
  "text": "Khi nước lên, bãi cọc chìm hẳn."
 },
 {
  "start": 50.99,
  "end": 51.63,
  "text": "Khi nước xuống,"
 },
 {
  "start": 51.63,
  "end": 54.53,
  "text": "cọc nhô lên như hàm răng."
 },
 {
  "start": 54.53,
  "end": 55.23,
  "text": "Lúc triều dâng,"
 },
 {
  "start": 55.23,
  "end": 56.72,
  "text": "thuyền nhẹ ra khiêu chiến,"
 },
 {
  "start": 56.72,
  "end": 58.86,
  "text": "rồi giả thua chạy vào."
 },
 {
  "start": 58.86,
  "end": 60.12,
  "text": "Hoằng Tháo đuổi theo,"
 },
 {
  "start": 60.12,
  "end": 60.91,
  "text": "vượt qua bãi cọc"
 },
 {
  "start": 60.91,
  "end": 62.67,
  "text": "mà không hề hay biết."
 },
 {
  "start": 62.67,
  "end": 63.91,
  "text": "Chờ nước rút,"
 },
 {
  "start": 63.91,
  "end": 64.34,
  "text": "Ngô Quyền"
 },
 {
  "start": 64.34,
  "end": 65.57,
  "text": "dốc toàn quân đánh trả."
 },
 {
  "start": 65.57,
  "end": 67.32,
  "text": "Thuyền giặc quay đầu,"
 },
 {
  "start": 67.32,
  "end": 69.96,
  "text": "đâm vào cọc, vỡ và lật."
 },
 {
  "start": 69.96,
  "end": 70.91,
  "text": "Hoằng Tháo bỏ mạng."
 },
 {
  "start": 70.91,
  "end": 72.35,
  "text": "Quân Nam Hán thua to."
 },
 {
  "start": 72.35,
  "end": 74.02,
  "text": "Ở Hải Môn,"
 },
 {
  "start": 74.02,
  "end": 75.48,
  "text": "vua Nam Hán nghe tin,"
 },
 {
  "start": 75.48,
  "end": 77.53,
  "text": "đành thu quân về nước."
 },
 {
  "start": 77.53,
  "end": 79.18,
  "text": "Mùa xuân năm 939,"
 },
 {
  "start": 79.18,
  "end": 80.7,
  "text": "Ngô Quyền xưng vương,"
 },
 {
  "start": 80.7,
  "end": 82.64,
  "text": "đóng đô ở Cổ Loa."
 },
 {
  "start": 82.64,
  "end": 84.08,
  "text": "Một bãi cọc và một con nước"
 },
 {
  "start": 84.08,
  "end": 87.09,
  "text": "đã mở ra thời kỳ độc lập lâu dài."
 },
 {
  "start": 87.09,
  "end": 87.45,
  "text": "Theo bạn,"
 },
 {
  "start": 87.45,
  "end": 89.43,
  "text": "điều gì làm nên chiến thắng này?"
 },
 {
  "start": 89.43,
  "end": 91.58,
  "text": "Cọc gỗ, thủy triều,"
 },
 {
  "start": 91.58,
  "end": 92.64,
  "text": "hay con người?"
 }
]