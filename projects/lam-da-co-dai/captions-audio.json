[
 {
  "start": 0.0,
  "end": 2.48,
  "text": "Cách đây khoảng 2.400 năm,"
 },
 {
  "start": 2.48,
  "end": 4.28,
  "text": "giữa sa mạc Ba Tư nóng bỏng,"
 },
 {
  "start": 4.28,
  "end": 5.78,
  "text": "người ta vẫn có đá lạnh."
 },
 {
  "start": 5.78,
  "end": 8.06,
  "text": "Không tủ lạnh, không điện,"
 },
 {
  "start": 8.06,
  "end": 9.96,
  "text": "vậy họ làm đá bằng cách nào?"
 },
 {
  "start": 9.96,
  "end": 10.92,
  "text": "Bước 1:"
 },
 {
  "start": 10.92,
  "end": 12.6,
  "text": "dẫn nước từ kênh ngầm Qanat"
 },
 {
  "start": 12.6,
  "end": 13.92,
  "text": "về những hồ nông"
 },
 {
  "start": 13.92,
  "end": 15.36,
  "text": "có tường cao che nắng."
 },
 {
  "start": 15.36,
  "end": 16.8,
  "text": "Bước 2: chờ đêm xuống."
 },
 {
  "start": 16.8,
  "end": 18.28,
  "text": "Không khí sa mạc rất khô,"
 },
 {
  "start": 18.28,
  "end": 19.8,
  "text": "nhiệt thoát dần lên trời đêm"
 },
 {
  "start": 19.8,
  "end": 21.28,
  "text": "và nước bắt đầu đóng băng."
 },
 {
  "start": 21.28,
  "end": 22.28,
  "text": "Sáng sớm,"
 },
 {
  "start": 22.28,
  "end": 23.7,
  "text": "thợ thu lấy những tấm đá."
 },
 {
  "start": 23.7,
  "end": 24.62,
  "text": "Bước 3:"
 },
 {
  "start": 24.62,
  "end": 26.78,
  "text": "chuyển đá vào Yakhchal,"
 },
 {
  "start": 26.78,
  "end": 28.42,
  "text": "ngôi nhà hình nón khổng lồ."
 },
 {
  "start": 28.42,
  "end": 30.22,
  "text": "Tường làm bằng vữa Sarooj,"
 },
 {
  "start": 30.22,
  "end": 31.72,
  "text": "trộn cát, đất sét,"
 },
 {
  "start": 31.72,
  "end": 33.72,
  "text": "lòng trắng trứng, vôi, lông dê"
 },
 {
  "start": 33.72,
  "end": 34.62,
  "text": "và tro."
 },
 {
  "start": 34.62,
  "end": 36.56,
  "text": "Vữa này chống thấm,"
 },
 {
  "start": 36.56,
  "end": 37.78,
  "text": "cách nhiệt quanh năm"
 },
 {
  "start": 37.78,
  "end": 39.1,
  "text": "và tường dày cỡ 2 m."
 },
 {
  "start": 39.1,
  "end": 41.24,
  "text": "Nhờ vậy, đá nằm lại qua cả mùa hè"
 },
 {
  "start": 41.24,
  "end": 42.5,
  "text": "để giữ thức ăn"
 },
 {
  "start": 42.5,
  "end": 43.76,
  "text": "và làm món tráng miệng."
 },
 {
  "start": 43.76,
  "end": 45.02,
  "text": "Một số Yakhchal ở Kerman"
 },
 {
  "start": 45.02,
  "end": 46.46,
  "text": "vẫn còn đứng đến hôm nay."
 },
 {
  "start": 46.46,
  "end": 47.46,
  "text": "Nếu không có điện,"
 },
 {
  "start": 47.46,
  "end": 49.0,
  "text": "bạn sẽ làm đá thế nào?"
 }
]